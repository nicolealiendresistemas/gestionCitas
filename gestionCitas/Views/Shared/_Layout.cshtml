<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - gestionCitas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/gestionCitas.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" />

    <style>
        .navbar-custom {
            background-color: #263875;
        }

            .navbar-custom .nav-link,
            .navbar-custom .navbar-brand {
                color: white !important;
            }

        .dropdown-menu {
            background-color: #263875;
        }

            .dropdown-menu .dropdown-item {
                color: white !important;
            }

                .dropdown-menu .dropdown-item:hover {
                    background-color: #415a9c;
                }

        body {
            padding-top: 70px; /* Asegúrate de dejar espacio para el navbar fijo */
        }
    </style>
</head>
<body>
    @if (!ViewData.ContainsKey("HideLayout") || !(bool)ViewData["HideLayout"])
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-dark navbar-custom fixed-top border-bottom box-shadow">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">gestionCitas</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">


                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Administración
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="UsuarioRols" asp-action="Index">UsuarioRols</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Roles" asp-action="Index">Roles</a></li>
                                    </ul>
                                </li>
                                
                            }

                            @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="gestionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Gestion
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="gestionDropdown">
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Pacientes" asp-action="Index">Pacientes</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Medicos" asp-action="Index">Médicos</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Citas" asp-action="Index">Citas</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Especialidades" asp-action="Index">Especialidades</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Recordatorios" asp-action="Index">Recordatorios</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="HorariosMedico" asp-action="Index">Horarios Médicos</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="recepcionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Reportes
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="recepcionDropdown">
                                        <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Index">Reportes Citas de Doctor</a></li>
                                        <li><a class="dropdown-item" asp-controller="Medicos" asp-action="ReportePacientes">Reportes Pacientes de Doctor</a></li>
                                        <li><a class="dropdown-item" asp-controller="Tickets" asp-action="Reporte">Tickets Reportes</a></li>
                                        <li><a class="dropdown-item" asp-controller="Medicos" asp-action="Reporte">Especialidades Reportes</a></li>
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole("Administrador") || User.IsInRole("Doctor"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="doctorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Funciones Médicas
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="doctorDropdown">
                                        <li><a class="dropdown-item" asp-area="" asp-controller="FichasMedicas" asp-action="Index">Fichas Médicas</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Consultas" asp-action="Index">Consultas</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Recetas" asp-action="Index">Recetas</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="HistorialMedico" asp-action="Index">Historial Médico</a></li>       
                                    </ul>
                                </li>
                            }
                            
                            @if (User.IsInRole("Paciente"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Pacientes" asp-action="Index">Tickets</a>
                                </li>
                            }
                            @if (User.IsInRole("Doctor"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="recepcionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Reportes
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="recepcionDropdown">
                                        <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Index">Reportes Citas de Doctor</a></li>
                                        <li><a class="dropdown-item" asp-controller="Medicos" asp-action="ReportePacientes">Reportes Pacientes de Doctor</a></li>
                                    </ul>
                                </li>
                            }

                        </ul>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-link nav-link text-light">Cerrar sesión</button>
                            </form>
                        }

                            
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    @if (!ViewData.ContainsKey("HideLayout") || !(bool)ViewData["HideLayout"])
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2024 - gestionCitas - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
