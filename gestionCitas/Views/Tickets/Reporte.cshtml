@model IEnumerable<gestionCitas.Models.Ticket>

@{
    ViewData["Title"] = "Reporte de Tickets";
}

<h1>Reporte de Tickets</h1>

<table class="table table-striped table-bordered mt-3">
    <thead>
        <tr>
            <th>Ticket ID</th>
            <th>Nombre del Paciente</th>
            <th>Fecha de Creación</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Id</td>
                <td>@ticket.Paciente?.Nombre</td>
                <td>@ticket.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <!-- Acción para gestionar citas -->
                    <a asp-controller="Citas" asp-action="Create" asp-route-ticketId="@ticket.Id" class="btn btn-primary btn-sm">Crear Cita</a>
                </td>
            </tr>
        }
    </tbody>
</table>
