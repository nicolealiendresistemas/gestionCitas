<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - gestionCitas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        /* Estilo de la barra lateral */
        .sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #263875;
            padding: 15px;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        }

            .sidebar h3 {
                color: white;
                text-align: center;
                margin-bottom: 20px;
            }

            .sidebar a {
                display: block;
                color: white;
                text-decoration: none;
                padding: 10px;
                margin-bottom: 10px;
                border-radius: 5px;
            }

                .sidebar a:hover {
                    background-color: #415a9c;
                }

        /* Contenedor de contenido */
        .content {
            margin-left: 260px;
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h3>Menú</h3>
        <a href="#bienvenida">Bienvenida</a>
        <a href="#imagenes">Galería de Imágenes</a>
        <a href="#dashboard">Dashboard de Estadísticas</a>
        <a href="#testimonios">Testimonios</a>
        <a href="#servicios">Servicios</a>
        <a href="#estadisticas">Estadísticas</a>
        <a href="#medicos">Médicos Especialistas</a>
    </div>
    <div class="content">
        @RenderBody() <!-- Aquí se inyecta el contenido de cada página -->
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
