<style>

        .chart-container {
            width: 100%;
            max-width: 400px; /* Ajusta este valor según tus necesidades */
            height: 400px;
            margin: 0 auto;
        }

        .dashboard {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        canvas {
            height: 300px !important; /* Ajustar la altura de los gráficos */
            max-height: 300px;
        }

        h2 {
            color: #007bff;
        }
    body {
        background-color: #f8faff;
    }

    .bg-welcome {
        background-color: #f8f9fa;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .img-container {
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .img-wrapper {
        position: relative;
        width: 300px;
        height: 200px;
        overflow: hidden;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .img-custom {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
        border-radius: 10px;
    }

    .img-wrapper:hover .img-custom {
        transform: scale(1.1);
    }

    .img-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        border-radius: 10px;
    }

    .img-wrapper:hover .img-overlay {
        opacity: 1;
    }

    .overlay-text {
        color: white;
        font-size: 1.5rem;
        font-weight: bold;
    }

    .btn-primary {
        background-color: #007bff;
        border: none;
        padding: 10px 20px;
        font-size: 1.2rem;
        transition: background-color 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .img-custom {
        width: 100%;
        max-width: 500px;
        border-radius: 10px;
    }

    .service-box {
        background-color: #f8f9fa;
    }

    .doctor-card {
        width: 250px;
    }

    .doctor-image {
        width: 100%;
        height: 400px;
        object-fit: cover;
        border-radius: 10px;
    }

    .testimonials-section {
        background-color: #f8f9fa;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .testimonial {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px;
    }

    .testimonial-img {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border: 3px solid #007bff;
        transition: transform 0.3s;
    }

    .testimonial-img:hover {
        transform: scale(1.1);
    }

    .testimonial-text {
        font-style: italic;
        font-size: 1.2rem;
        color: #555;
        max-width: 600px;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: black;
        border-radius: 50%;
        padding: 10px;
    }

    h5 {
        color: #007bff;
    }
</style>
