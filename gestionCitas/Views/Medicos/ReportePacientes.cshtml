@model IEnumerable<gestionCitas.Models.Paciente>

@{
    ViewData["Title"] = "Reporte de Pacientes por Médico";
}

<h1>Reporte de Pacientes por Médico</h1>

<div class="mb-3">
    <form asp-action="ReportePacientes" method="get">
        <div class="form-group">
            <label for="MedicoId">Seleccione un Médico:</label>
            <select id="MedicoId" name="medicoId" class="form-control" asp-items="@(ViewData["MedicoId"] as SelectList)">
                <option value="">-- Seleccione un Médico --</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Ver Pacientes</button>
    </form>
</div>

@if (ViewBag.SelectedMedicoName != null)
{
    <h2>Pacientes del Médico: @ViewBag.SelectedMedicoName</h2>
}

@if (Model.Any())
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Fecha de Nacimiento</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Dirección</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var paciente in Model)
            {
                <tr>
                    <td>@paciente.Nombre</td>
                    <td>@paciente.FechaNacimiento?.ToString("dd/MM/yyyy")</td>
                    <td>@paciente.Telefono</td>
                    <td>@paciente.Email</td>
                    <td>@paciente.Direccion</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (ViewBag.SelectedMedicoId != null)
{
    <div class="alert alert-warning">No hay pacientes asignados a este médico.</div>
}
